# Copy to .env and fill in. Never commit .env.

# Server only: used by the /api routes, never sent to the browser.
GEMINI_API_KEY=
# Optional: override the Gemini model.
# GEMINI_MODEL=gemini-3.8-flash

# Browser: Supabase project URL and anon (public) key. Google sign-in must be
# turned on in Supabase: Authentication > Providers > Google.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=